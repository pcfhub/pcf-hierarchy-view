<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Display names and descriptions for everything declared in
    ControlManifest.Input.xml. PCFHub reads the manifest, so these strings are
    what appear in the component's API reference on the hub as well as in the
    maker's properties pane.

    Copy this file to add a language — HierarchyView.3082.resx for Spanish, and so
    on — then list it under <resources> in the manifest.
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="type" type="xsd:string" />
              <xsd:attribute name="mimetype" type="xsd:string" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <data name="HierarchyView_Name" xml:space="preserve">
    <value>Hierarchy View</value>
  </data>
  <data name="HierarchyView_Desc" xml:space="preserve">
    <value>A record's place in its hierarchy — ancestors above, children below — from its parent lookup.</value>
  </data>

  <data name="value_Name" xml:space="preserve">
    <value>Parent lookup</value>
  </data>
  <data name="value_Desc" xml:space="preserve">
    <value>The lookup to this table's own parent record — Parent Account, for example. The control reads the hierarchy from it and never writes to it.</value>
  </data>

  <data name="detailColumns_Name" xml:space="preserve">
    <value>Detail columns</value>
  </data>
  <data name="detailColumns_Desc" xml:space="preserve">
    <value>Logical names, comma-separated, shown under each record's name — "address1_city, revenue", for example. Up to three.</value>
  </data>

  <data name="initialDepth_Name" xml:space="preserve">
    <value>Levels open at start</value>
  </data>
  <data name="initialDepth_Desc" xml:space="preserve">
    <value>How many levels below this record are expanded on first render. 0 shows its children collapsed; 1 shows them.</value>
  </data>

  <data name="maxChildren_Name" xml:space="preserve">
    <value>Children per node</value>
  </data>
  <data name="maxChildren_Desc" xml:space="preserve">
    <value>How many child records are loaded under one node. A node with more says so.</value>
  </data>

  <data name="sampleData_Name" xml:space="preserve">
    <value>Sample data (demo only)</value>
  </data>
  <data name="sampleData_Desc" xml:space="preserve">
    <value>A JSON tree the control shows instead of querying Dataverse. For PCFHub's demo and for previewing the layout; leave blank on a real form.</value>
  </data>

  <!--
    Runtime strings, read with context.resources.getString(). Anything the user
    can read belongs here rather than as a literal in the components. Every
    language listed in the manifest carries the SAME key set — npm run check
    compares them — and {0} is a placeholder the code fills.
  -->
  <data name="HierarchyView_NoAccess" xml:space="preserve">
    <value>You do not have access to this value.</value>
  </data>
  <data name="HierarchyView_NotAvailable" xml:space="preserve">
    <value>The hierarchy is not available on this host.</value>
  </data>
  <data name="HierarchyView_SaveFirst" xml:space="preserve">
    <value>Save the record to see its hierarchy.</value>
  </data>
  <data name="HierarchyView_NotALookup" xml:space="preserve">
    <value>This control needs a lookup to the record's own table.</value>
  </data>
  <data name="HierarchyView_Loading" xml:space="preserve">
    <value>Loading…</value>
  </data>
  <data name="HierarchyView_NoChildren" xml:space="preserve">
    <value>No child records.</value>
  </data>
  <data name="HierarchyView_Expand" xml:space="preserve">
    <value>Expand {0}</value>
  </data>
  <data name="HierarchyView_Collapse" xml:space="preserve">
    <value>Collapse {0}</value>
  </data>
  <data name="HierarchyView_Children" xml:space="preserve">
    <value>Children: {0}</value>
  </data>
  <data name="HierarchyView_Current" xml:space="preserve">
    <value>This record</value>
  </data>
  <data name="HierarchyView_Open" xml:space="preserve">
    <value>Open {0}</value>
  </data>
  <data name="HierarchyView_LoadFailed" xml:space="preserve">
    <value>The hierarchy could not be read: {0}</value>
  </data>
  <data name="HierarchyView_Truncated" xml:space="preserve">
    <value>Showing the first {0}.</value>
  </data>
  <data name="HierarchyView_BadSample" xml:space="preserve">
    <value>The sample data could not be read.</value>
  </data>
  <data name="HierarchyView_Retry" xml:space="preserve">
    <value>Try again</value>
  </data>
  <data name="HierarchyView_ShowAll" xml:space="preserve">
    <value>Show all children</value>
  </data>
  <data name="HierarchyView_NotFound" xml:space="preserve">
    <value>This record could not be found in its table.</value>
  </data>
</root>
