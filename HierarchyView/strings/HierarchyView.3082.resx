  <data name="HierarchyView_Name" xml:space="preserve">
    <value>Vista de jerarquía</value>
  </data>
  <data name="HierarchyView_Desc" xml:space="preserve">
    <value>El lugar de un registro en su jerarquía — antecesores arriba, hijos abajo — a partir de su búsqueda de elemento primario.</value>
  </data>

  <data name="value_Name" xml:space="preserve">
    <value>Búsqueda de elemento primario</value>
  </data>
  <data name="value_Desc" xml:space="preserve">
    <value>La búsqueda al registro primario de esta misma tabla — «Cuenta primaria», por ejemplo. El control lee la jerarquía de ella y nunca escribe en ella.</value>
  </data>

  <data name="detailColumns_Name" xml:space="preserve">
    <value>Columnas de detalle</value>
  </data>
  <data name="detailColumns_Desc" xml:space="preserve">
    <value>Nombres lógicos, separados por comas, mostrados bajo el nombre de cada registro — «address1_city, revenue», por ejemplo. Hasta tres.</value>
  </data>

  <data name="initialDepth_Name" xml:space="preserve">
