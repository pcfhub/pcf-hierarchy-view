  </data>
  <data name="initialDepth_Desc" xml:space="preserve">
    <value>Cuántos niveles bajo este registro se expanden en la primera presentación. 0 muestra sus hijos contraídos; 1 los muestra.</value>
  </data>

  <data name="maxChildren_Name" xml:space="preserve">
