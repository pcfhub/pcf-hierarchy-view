  <data name="HierarchyView_Name" xml:space="preserve">
    <value>Vue hiérarchique</value>
  </data>
  <data name="HierarchyView_Desc" xml:space="preserve">
    <value>La place d'un enregistrement dans sa hiérarchie — parents au-dessus, enfants en dessous — à partir de sa recherche parent.</value>
  </data>

  <data name="value_Name" xml:space="preserve">
    <value>Recherche parent</value>
  </data>
  <data name="value_Desc" xml:space="preserve">
    <value>La recherche vers l'enregistrement parent de cette même table — « Compte parent », par exemple. Le contrôle y lit la hiérarchie et n'y écrit jamais.</value>
  </data>

  <data name="detailColumns_Name" xml:space="preserve">
    <value>Colonnes de détail</value>
  </data>
  <data name="detailColumns_Desc" xml:space="preserve">
    <value>Noms logiques, séparés par des virgules, affichés sous le nom de chaque enregistrement — « address1_city, revenue », par exemple. Trois au plus.</value>
  </data>

  <data name="initialDepth_Name" xml:space="preserve">
    <value>Niveaux ouverts au départ</value>
  </data>
  <data name="initialDepth_Desc" xml:space="preserve">
    <value>Nombre de niveaux sous cet enregistrement développés au premier affichage. 0 montre ses enfants repliés ; 1 les affiche.</value>
  </data>

  <data name="maxChildren_Name" xml:space="preserve">
