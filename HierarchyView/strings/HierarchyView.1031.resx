  <data name="HierarchyView_Name" xml:space="preserve">
    <value>Hierarchieansicht</value>
  </data>
  <data name="HierarchyView_Desc" xml:space="preserve">
    <value>Die Position eines Datensatzes in seiner Hierarchie – übergeordnete Datensätze oben, untergeordnete unten – aus seiner Suche nach dem übergeordneten Element.</value>
  </data>

  <data name="value_Name" xml:space="preserve">
    <value>Übergeordnete Suche</value>
  </data>
  <data name="value_Desc" xml:space="preserve">
    <value>Die Suche nach dem übergeordneten Datensatz derselben Tabelle – zum Beispiel „Übergeordnete Firma“. Das Steuerelement liest die Hierarchie daraus und schreibt nie hinein.</value>
  </data>

  <data name="detailColumns_Name" xml:space="preserve">
    <value>Detailspalten</value>
  </data>
  <data name="detailColumns_Desc" xml:space="preserve">
    <value>Logische Namen, durch Kommas getrennt, die unter dem Namen jedes Datensatzes angezeigt werden – zum Beispiel „address1_city, revenue“. Bis zu drei.</value>
  </data>

  <data name="initialDepth_Name" xml:space="preserve">
    <value>Anfangs geöffnete Ebenen</value>
  </data>
  <data name="initialDepth_Desc" xml:space="preserve">
    <value>Wie viele Ebenen unter diesem Datensatz beim ersten Rendern aufgeklappt sind. 0 zeigt die untergeordneten Datensätze zugeklappt, 1 zeigt sie an.</value>
  </data>

  <data name="maxChildren_Name" xml:space="preserve">
    <value>Untergeordnete pro Knoten</value>
  </data>
  <data name="maxChildren_Desc" xml:space="preserve">
    <value>Wie viele untergeordnete Datensätze unter einem Knoten geladen werden. Ein Knoten mit mehr weist darauf hin.</value>
  </data>

  <data name="sampleData_Name" xml:space="preserve">
    <value>Beispieldaten (nur Demo)</value>
  </data>
  <data name="sampleData_Desc" xml:space="preserve">
    <value>Ein JSON-Baum, den das Steuerelement anstelle einer Dataverse-Abfrage anzeigt. Für die PCFHub-Demo und zur Vorschau des Layouts; auf einem echten Formular leer lassen.</value>
  </data>

