<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <!--
    The version here is what the Power Platform upgrades on, and the release
    workflow refuses to publish a tag that disagrees with it. Bump this in the
    same commit as the tag.
  -->
  <control namespace="PCFHub"
           constructor="HierarchyView"
           version="0.1.1"
           display-name-key="HierarchyView_Name"
           description-key="HierarchyView_Desc"
           control-type="virtual">

    <!--
      Leave this disabled unless the control calls a third-party service.

      `enabled="true"` makes the control **premium**, and premium is a cost
      somebody else pays: every end user of an app containing this component
      then needs a Power Apps licence rather than an Office 365 one. Nothing
      fails to build, nothing warns at install, and the person who finds out is
      not the person who typed it — so this is worth confirming with whoever
      owns the control rather than flipping to make a `fetch` work.

      When it is genuinely enabled, list every domain. `<domain>` children are
      declarative and can be listed under `enabled="false"` too, which is the
      schema's own second example; it is the `enabled` attribute alone that
      carries the licensing consequence.

          <external-service-usage enabled="true">
            <domain>tile.example.com</domain>
          </external-service-usage>

      `npm run check` fails on `enabled="true"` with no domain, and warns on
      `enabled="true"` at all.
    -->
    <external-service-usage enabled="false" />

    <!--
      PCFHub generates the component's API reference from this file, at the tag
      of each release.

      It records `display-name-key` and `description-key` *verbatim* — it does
      not read the .resx — so a reader sees the key itself unless something
      changes it. Two ways to get readable text: keep the keys themselves
      readable, or correct them once in the hub's admin panel, where editing a
      property locks that field so later syncs leave it alone.

      The platform still resolves these against the .resx for the maker's
      properties pane, so the keys must exist there either way.
    -->
    <!--
      The parent lookup: a Lookup.Simple whose target is the record's own table
      — Account.parentaccountid, Contact.parentcustomerid where it points at
      contact, a custom table's "Parent" column. Everything else the control
      needs it reads from this one binding: the target table from
      getTargetEntityType(), the column to filter children on from
      attributes.LogicalName, and the record's own parent from raw[0].

      Lookup.Simple is model-driven only, so there is no canvas page.
    -->
    <property name="value"
              display-name-key="value_Name"
              description-key="value_Desc"
              of-type="Lookup.Simple"
              usage="bound"
              required="true" />

    <!--
      Logical names, comma-separated, shown under each card's title. Read as
      formatted values, so a currency arrives with its symbol and a lookup as
      its name. Anything that is not a logical name is dropped rather than sent
      to the server.
    -->
    <property name="detailColumns"
              display-name-key="detailColumns_Name"
              description-key="detailColumns_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <!--
      How many levels below the current record open on first render. 0 shows
      the record's children collapsed; 1 (the default) shows them; deeper
      levels are loaded one query per node, so keep this small on a wide tree.
    -->
    <property name="initialDepth"
              display-name-key="initialDepth_Name"
              description-key="initialDepth_Desc"
              of-type="Whole.None"
              usage="input"
              required="false"
              default-value="1" />

    <!--
      Children loaded per node, passed as the query's page size. A node with
      more says so rather than loading them all.
    -->
    <property name="maxChildren"
              display-name-key="maxChildren_Name"
              description-key="maxChildren_Desc"
              of-type="Whole.None"
              usage="input"
              required="false"
              default-value="50" />

    <!--
      A JSON tree the control renders INSTEAD of querying Dataverse. It exists
      for PCFHub's demo, whose harness has no Web API, and for a maker who
      wants to see the layout before binding it. Leave it blank on a real form:
      when set, the control never queries, whatever the record holds.

          { "current": "c1",
            "records": [ { "id": "r1", "name": "Contoso", "parentId": null },
                         { "id": "c1", "name": "Contoso West", "parentId": "r1",
                           "details": { "City": "Seattle" }, "childCount": 2 } ] }
    -->
    <property name="sampleData"
              display-name-key="sampleData_Name"
              description-key="sampleData_Desc"
              of-type="Multiple"
              usage="input"
              required="false" />

    <resources>
      <code path="index.ts" order="1" />
      <css path="css/HierarchyView.css" order="1" />
      <!--
        Every language the control ships.

        A .resx that exists on disk but is not listed here is not shipped, and
        nothing warns — the file is simply never packed, and the control runs
        in English for that locale while the repository looks translated.
        `npm run check` catches both that and a key missing from a language.

        Drop the ones you will not maintain. A stale translation is worse than
        an honest fallback to English, and every key added to 1033 is a key
        owed to each file listed here.

        THE ORDER IS DELIBERATE AND 1033 GOES LAST. `pcf-start` picks the .resx
        by manifest order rather than by locale: it reads whichever file is
        listed *last* and ignores the LCID and the browser language entirely.
        The platform itself ignores the order completely — a real app resolves
        from the user's provisioned language — so `npm start` is the only thing
        in the world that reads this order, and it is ordered for it. Listing
        1033 first is the tidier-looking arrangement and it makes `npm start`
        render the whole control in Japanese, which reads as a broken build.

        The consequence to remember: ADD A NEW LANGUAGE ABOVE THIS LINE, not
        below it. Appending a sixth file after 1033 silently moves the harness
        to that language, and the symptom shows up in a `npm start` session
        nobody connects to a manifest edit.
      -->
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
      <resx path="strings/HierarchyView.3082.resx" version="1.0.0" />
      <resx path="strings/HierarchyView.1036.resx" version="1.0.0" />
      <resx path="strings/HierarchyView.1031.resx" version="1.0.0" />
      <resx path="strings/HierarchyView.1041.resx" version="1.0.0" />
      <resx path="strings/HierarchyView.1033.resx" version="1.0.0" />
    </resources>

    <!--
      Both optional: a host without them hands the control a context lacking
      the member, and the control names the state ("not available on this
      host") rather than failing to load — with required="true" the component
      would not load at all where the feature is missing.

      WebAPI reads the hierarchy: retrieveMultipleRecords with a FetchXML query
      on a hierarchical lookup, retrieveRecord and an OData filter on one that
      is not. Utility supplies getEntityMetadata for the table's primary id and
      name columns. Whether the lookup is hierarchical is read with a
      same-origin fetch of EntityDefinitions, which no feature gates.
    -->
    <feature-usage>
      <uses-feature name="WebAPI" required="false" />
      <uses-feature name="Utility" required="false" />
    </feature-usage>
  </control>
</manifest>
